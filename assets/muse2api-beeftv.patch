+            if seconds:
+                fields["duration"] = seconds
+            upload = form.get("input_reference")
+            if upload is not None:
+                if not hasattr(upload, "read"):
+                    raise HTTPException(400, "input_reference must be an image file")
+                data = await upload.read(MAX_REFERENCE_IMAGE_BYTES + 1)
+                if len(data) > MAX_REFERENCE_IMAGE_BYTES:
+                    raise HTTPException(413, "reference image is too large")
+                mime = upload.content_type or "application/octet-stream"
+                if not mime.startswith("image/"):
+                    raise HTTPException(400, "input_reference must be an image")
